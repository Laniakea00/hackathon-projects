# ── PostgreSQL ───────────────────────────────────────────────────────────────
# For local development (docker-compose spins up the DB on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qazcode

# ── LLM endpoint (OpenAI-compatible) ─────────────────────────────────────────
LLM_BASE_URL=https://hub.qazcode.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=oss-120b

# ── Embedding model (optional override) ──────────────────────────────────────
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
